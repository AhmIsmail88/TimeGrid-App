<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the gradient of the legacy ic_launcher.png so the icon looks the
     same whether the launcher masks it or not. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2176D2"
        android:endColor="#0D47A1" />
</shape>